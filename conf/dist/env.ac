#
# GENERAL
#

USER_CONF_PATH=/azerothcore/apps/docker/config-docker.sh
DATAPATH=/azerothcore/env/dist/data

#
# COMPILER
#

CTYPE=RelWithDebInfo
CSCRIPTS=static
AC_CCACHE=true

#
# SIMPLE RESTARTER
#
AC_RESTARTER_BINPATH=
AC_RESTARTER_BINFILE=
AC_RESTARTER_WITHGDB=

# =========================================================================
# CUSTOM FORK CONFIGURATIONS - DO NOT REMOVE DURING REBASE
# =========================================================================

# ----------------------------------------
# 1. EXPERIENCE (XP) RATES
# ----------------------------------------
# Multilplier for XP gained from killing monsters.
AC_RATE_XP_KILL=3

# Multiplier for XP gained from completing quests.
AC_RATE_XP_QUEST=3

# Multiplier for XP gained from exploring map areas.
AC_RATE_XP_EXPLORE=2

# ----------------------------------------
# 2. LOOT & GOLD DROP RATES
# ----------------------------------------
# Multiplier for gold dropped by monsters.
AC_RATE_DROP_MONEY=2
AC_RATE_REWARD_QUEST_MONEY=2

# Drop rates for regular and rare equipment.
AC_RATE_DROP_ITEM_POOR=1
AC_RATE_DROP_ITEM_NORMAL=1.5
AC_RATE_DROP_ITEM_UNCOMMON=2
AC_RATE_DROP_ITEM_RARE=2
AC_RATE_DROP_ITEM_EPIC=1.5
AC_RATE_DROP_ITEM_LEGENDARY=1

# ----------------------------------------
# 3. SKILL RATES
# ----------------------------------------
# Speed modifier for how fast weapon & defense skills increase.
AC_SKILL_GAIN_WEAPON=5
AC_SKILL_GAIN_DEFENSE=5

# Speed modifier for how fast professions level up.
AC_SKILL_GAIN_GATHERING=3
AC_SKILL_GAIN_CRAFTING=3

# ----------------------------------------
# 4. REPUTATION & HONOR RATES
# ----------------------------------------
# Multiplier for reputation gained from killing monsters and doing quests.
AC_RATE_REPUTATION_GAIN=3

# Multiplier for honor points gained in PvP.
AC_RATE_HONOR=3

# ----------------------------------------
# 5. CONVENIENCE & SPEED RATES
# ----------------------------------------
# Multiplier for player health regeneration.
AC_RATE_HEALTH=2

# Multiplier for player mana regeneration.
AC_RATE_MANA=2
